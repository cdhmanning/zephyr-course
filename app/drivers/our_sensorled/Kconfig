config OUR_SENSORLED
	bool "Our sensor LED driver"
	default y
	depends on DT_HAS_OUR_SENSORLED_ENABLED
	select GPIO
	help
	  Enables the custom driver for SENSORLED

config OUR_SENSORLED_SHELL
	bool "Our sensor LED driver shell"
	default y
	depends on OUR_SENSORLED && SHELL
	help
	  Enables the custom driver sensorled shell
