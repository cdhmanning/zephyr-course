menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice
    prompt "LED blink sleep time"
    default BLINK_SLEEP_MEDIUM

config BLINK_SLEEP_FAST
    bool "250ms (fast)"

config BLINK_SLEEP_MEDIUM
    bool "1s (medium)"

config BLINK_SLEEP_SLOW
    bool "2s (slow)"

endchoice

menuconfig LED_ADVANCED_SETTINGS
    bool "Advanced LED settings"
    default n

if LED_ADVANCED_SETTINGS

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_TIME_MS
    int "LED fade duration (ms)"
    range 0 1000
    default 500

menu "Expert settings"

    config LED_DEBUG
    bool "Enable LED debugging"
    default n

    config LED_CUSTOM_BLINKING
        bool "Custom blink pattern"
        default n
    
endmenu
    
endif # LED_ADVANCED_SETTINGS

endif # LED_SUBSYSTEM


config BLINK_SLEEP_TIME_MS
    int
    default 250 if BLINK_SLEEP_FAST
    default 1000 if BLINK_SLEEP_MEDIUM
    default 2000 if BLINK_SLEEP_SLOW
    default 0

source "Kconfig.zephyr"